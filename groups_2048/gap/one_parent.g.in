# Template: replace DIM, KK, TYP (+, -, r) and SEED, then run  gap -q -b <file>  from this directory.
Read("step1.g");
Reset(GlobalMersenneTwister, SEED);; Reset(GlobalRandomSource, SEED);;
H := QFGroup(DIM, KK, "TYP");;
r := Step1CountC(H, QFGroupFp(DIM, KK, "TYP"));;
Print("RESULT d=", DIM, " k=", KK, " type TYP seed SEED : ", r, "\n");
QUIT;
