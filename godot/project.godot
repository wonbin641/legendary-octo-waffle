; Yarr! 07 (야르 07) - Godot 4 port
config_version=5

[application]
config/name="Yarr! 07"
config/name_localized={"ko": "야르 07"}
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.051, 0.071, 0.125, 1)
boot_splash/show_image=false
config/quit_on_go_back=false

[autoload]
Phys="*res://scripts/phys.gd"
Snd="*res://scripts/snd.gd"
Store="*res://scripts/store.gd"
Music="*res://scripts/music.gd"
Cloud="*res://scripts/cloud.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/mode.pc=2
window/stretch/mode="disabled"
window/handheld/orientation=4

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[physics]
common/physics_ticks_per_second=60

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
rendering_device/driver.windows="vulkan"
rendering_device/fallback_to_d3d12=true
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
textures/default_filters/anisotropic_filtering_level=4
textures/default_filters/anisotropic_filtering_level.mobile=3
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=1024

[shader_globals]

yard_exposure={
"type": "float",
"value": 1.0
}
yard_tone_k={
"type": "float",
"value": 1.0
}
yard_fog_density={
"type": "float",
"value": 0.0
}
yard_fog_disp={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
yard_fog_scene={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
yard_fog_end={
"type": "float",
"value": 100.0
}
