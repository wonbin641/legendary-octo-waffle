; Yarr! 07 (야르 07) - Godot 4 port
config_version=5

[application]
config/name="Yarr! 07"
config/name_localized={"ko": "야르 07"}
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.051, 0.071, 0.125, 1)
boot_splash/show_image=false

[autoload]
Phys="*res://scripts/phys.gd"
Snd="*res://scripts/snd.gd"
Store="*res://scripts/store.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="disabled"

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[physics]
common/physics_ticks_per_second=60

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=false
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=1024
